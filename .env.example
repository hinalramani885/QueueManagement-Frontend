# Copy to ".env" and fill in. ".env" is git-ignored.

# ---- Backend ----
# Dev server proxy target for /api, /ws and /uploads (default: http://localhost:8081)
VITE_PROXY_TARGET=http://localhost:8081
# The dev server uses HTTPS with a local mkcert certificate (needed for camera/QR on phones).
# Set to false for plain HTTP (camera and push notifications then only work on localhost).
# VITE_DEV_HTTPS=false
# Only set these if the backend is on a different origin than the frontend (no proxy).
# VITE_BACKEND_URL=https://api.example.com
# VITE_API_BASE_URL=https://api.example.com/api
# VITE_WS_URL=https://api.example.com/ws

# ---- Contact address shown in the app (default qflowapplication@gmail.com) ----
# VITE_SUPPORT_EMAIL=qflowapplication@gmail.com

# ---- Razorpay (public key id; required for the pricing pages) ----
VITE_RAZORPAY_KEY_ID=

# ---- Firebase (optional; push notifications are disabled when empty) ----
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
